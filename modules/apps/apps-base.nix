{ pkgs, ... }:

{
  environment.systemPackages = with pkgs; [
    # =========================================================================
    # 1. 核心編輯器、Shell 與路徑跳轉 (交互靈魂)
    # =========================================================================
    helix                     # 現代終端模態純文字編輯器 (hx - 救命與配置核心)
    bash                      # GNU 標準 Bash
    fish                      # 現代化開箱即用互動式 Fish Shell
    zsh                       # 備用強大 Z Shell
    aria2                     # 輕量級多協議、多執行緒命令列下載神兵
    axel                      # 極度精簡迅速的 HTTP/FTP 下載加速器
    strace                    # 追蹤程式向 Linux 核心發起的所有系統呼叫 (syscall)
    arping                    # 透過 ARP 請求發現並探測局域網物理主機
    socat                     # 雙向資料串流轉發與端口重定向多功能工具
    netcat                    # 經典網路連線瑞士軍刀 (nc)
    ffmpeg



    # =========================================================================
    # 2. 現代極客檔案瀏覽與極速搜尋三劍客 (必備生產力)
    # =========================================================================
    ripgrep                   # rg - 全球最快程式碼與文字遞迴搜尋工具
    fd                        # 簡潔、極速、符合人體工學的 find 現代替代品
    eza                       # 帶圖示、Git 狀態與檔案屬性的現代 ls 替代品

    # =========================================================================
    # 3. 程式碼託管、Git 傳輸與資料查詢 (開機拉配置必備)
    # =========================================================================
    git                       # 分散式版本控制核心本體
    gh                        # GitHub 官方命令列客戶端 (管理 Repo/PR/Token)
    gitoxide                  # gix - Rust 重新實現的純粹高效 Git 客戶端
    jql                       # 終端極度乾淨、好用的 JSON 查詢過濾工具
    jq                        # 經典通用 JSON 解析器

    # =========================================================================
    # 4. 基礎網路通訊、DNS 診斷與加密金鑰 (救命連網鏈)
    # =========================================================================
    networkmanager            # 網路連線管理主程式與 nmcli 控制器
    curl                      # 萬能命令列網路資料傳輸工具 (開機必備)
    wget                      # 傳統非互動式網路檔案下載器
    bind                      # DNS 查詢工具集 (包含 dig, nslookup - 排查 DNS 必備)
    openssl                   # SSL/TLS 協議與密碼學核心 (Git 認證與證書基礎)
    openssh                   # SSH 遠端連線客戶端與金鑰生成工具
    gnupg                     # GPG 密鑰加解密與簽名工具

    # =========================================================================
    # 5. 終端多媒體、相簿與基礎高精計算 (無 GUI 下的感官延伸)
    # =========================================================================
    mpv                       # 萬能極簡極客播放器 (也是終端檢視圖片的救命工具)
    bc                        # 經典 Unix 任意精度計算語言
    calc                      # 互動式 C 風格高級任意精度計算器
    libqalculate              # 終端全能高精度計算器庫

    # =========================================================================
    # 6. 系統資訊、核心進程與磁碟硬體探針 (除錯監控)
    # =========================================================================
    procps                    # 核心進程管理工具集 (ps, top, free, sysctl)
    killall                   # 依程式名稱批量強制終止進程
    pstree                    # 樹狀圖展示進程父子層級關係
    file                      # 看穿二進位檔案本質與架構的照妖鏡
    binutils                  # strings 與 readelf 二進位剖析工具集
    xxd                       # 十六進位/二進位互轉工具 (顯微鏡必備)
    iotop                     # 實時監控各進程硬碟 I/O 讀寫頻寬佔用
    sysstat                   # 包含 sar, iostat 等系統底層效能瓶頸採集套件
    dust                      # 終端可視化目錄硬碟空間佔用分析 (du 現代版)
    lsof                      # 查詢特定文件/連接埠被哪些進程佔用
    mtr                       # 結合 ping 與 traceroute 的全動態路由診斷器
    iw                        # Linux 官方底層無線網卡硬體配置工具
    ethtool                   # 物理網卡硬體狀態、速率與暫存器診斷
    alsa-utils                # ALSA 底層音訊除錯工具 (aplay, amixer)
    pciutils                  # lspci - PCI-E 匯流排與顯卡硬體拓撲查詢
    usbutils                  # lsusb - 物理 USB 總線硬體枚舉與狀態查詢
    keyd                      # 系統底層鍵盤映射重定義守護進程
    lm_sensors                # CPU/主機板溫度與風扇轉速感測器
    power-profiles-daemon     # 系統電源效能模式切換守護進程
    brightnessctl             # 螢幕背光硬體調節工具
    ddcutil                   # 透過 DDC/CI 協議調節外接顯示器硬體亮度

    # =========================================================================
    # 7. 磁碟分割、維護與檔案系統工具
    # =========================================================================
    parted                    # 命令列動態磁碟分區調整工具
    gptfdisk                  # gdisk - GUID 分區表 (GPT) 專用進階維護工具
    lvm2                      # 邏輯捲軸管理工具 (LVM)

    # =========================================================================
    # 8. 萬能解壓縮工具全家桶 (任何壓縮包直接搞定)
    # =========================================================================
    ouch                      # 主力 Rust 萬能解壓縮工具 (極速且智慧識別格式)
    _7zz                      # 官方最新 7-Zip 完整單獨執行檔
    p7zip                     # 經典 POSIX 移植版 7z 工具
    unzip                     # 傳統 ZIP 解壓縮工具
    unrar                     # 專用 RAR 格式提取工具
    unar                      # 處理舊 Windows 壓縮包編碼亂碼的救星
    dtrx                      # 智慧解壓縮工具 (自動包裝資料夾，防止壓縮包炸彈)

    # =========================================================================
    # 9. 基礎桌面與音訊支撐組件 (若加載桌面則提供底座，純終端下亦無害)
    # =========================================================================
    pamixer                   # 終端 PulseAudio/PipeWire 音量控制
    playerctl                 # 多媒體播放控制 CLI (支援鍵盤切歌/暫停)
    wl-clipboard              # Wayland 原生剪貼簿工具 (wl-copy / wl-paste)
    appimage-run              # 直接執行通用 Linux AppImage 的黑魔法
    material-symbols          # Google Material 符號圖示字型
    rubik                     # 現代幾何無襯線字型
    cascadia-code             # 微軟高質感終端程式碼字型 (支援連字)
    papirus-icon-theme        # 扁平化現代開源圖示主題
    qt6.qtbase                # Qt6 基礎圖形庫核心
    qt6.qtimageformats        # Qt6 額外圖像格式支援插件
    qt6.qtdeclarative         # Qt6 QML/Quick 動態介面引擎
    qt6.qtshadertools         # Qt6 著色器轉換與渲染工具
    hyprlauncher              # 應用程式啟動器
    hyprshutdown              # 關機/重啟控制腳本
    wlogout                   # 圖形化登出/鎖定/關機選單
    hyprpaper                 # 壁紙渲染守護進程
    hyprpicker                # 螢幕顏色吸管工具
    swappy                    # 截圖即時標註與編輯工具
    grim                      # Wayland 原生截圖核心抓取工具
    slurp                     # Wayland 區域螢幕選取框工具
  ];
}
